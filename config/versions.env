# =============================================================================
# config/versions.env — 版本号「单一事实源」（Single Source of Truth）
#
# 所有平台安装脚本（install.sh / install-macos.sh / install.ps1）、Dockerfile
# 与 CI 引用的版本号都集中在这里，改版本只需改这一个文件。
#
# 格式：简单的 KEY=VALUE（无空格、无引号），可被 bash 直接 `source`，
#       也可被 PowerShell 逐行解析（见 install.ps1）。
# 环境变量优先级：调用方已显式 export 的同名变量会覆盖这里的默认值。
# =============================================================================

# Ghidra：https://github.com/NationalSecurityAgency/ghidra/releases
GHIDRA_VERSION=12.1.4
GHIDRA_BUILD=Ghidra_12.1.4_build
GHIDRA_DATE=20260921

# JDK 主版本（Ghidra 12.x 要求 JDK 21）
JDK_FEATURE=21

# Node：REA 要求 ^22.19 || ^24.11 || >=26（这里是脚本在缺失 Node 时安装的版本）
# 注意：刻意用 REA_NODE_VERSION 而非 NODE_VERSION，避免与 fnm/nvm 等工具
# 注入的同名环境变量冲突。
REA_NODE_VERSION=22.19.0

# REA：npm 包 rea-agents 的锁定版本
REA_VERSION=6.4.0
